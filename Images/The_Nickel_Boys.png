					<div id="mw-content-text" class="mw-body-content"><div class="mw-content-ltr mw-parser-output" lang="en" dir="ltr" data-mw-parsoid-version="0.25.0.0-alpha1" data-mw-html-version="2.8.0"><section data-mw-section-id="0" id="mwAQ"><div class="shortdescription nomobile noexcerpt noprint searchaux" style="display:none" about="#mwt1" typeof="mw:Transclusion" id="mwAg" data-mw='{"parts":[{"template":{"target":{"wt":"Short description","href":"./Template:Short_description"},"params":{"1":{"wt":"2019 novel by Colson Whitehead"}},"i":0}}]}'>2019 novel by Colson Whitehead</div><span class="mw-empty-elt" about="#mwt1"><link rel="mw:PageProp/Category" href="./Category:Articles_with_short_description"/><link rel="mw:PageProp/Category" href="./Category:Short_description_matches_Wikidata"/></span>
<span class="mw-empty-elt" about="#mwt2" typeof="mw:Transclusion" id="mwAw" data-mw='{"parts":[{"template":{"target":{"wt":"about","href":"./Template:About"},"params":{"1":{"wt":"the novel"},"2":{"wt":"the film adaptation"},"3":{"wt":"Nickel Boys"}},"i":0}}]}'><style data-mw-deduplicate="TemplateStyles:r1368532237" typeof="mw:Extension/templatestyles" about="#mwt3" data-mw='{"name":"templatestyles","attrs":{"src":"Module:Hatnote/styles.css"},"body":{"extsrc":""}}'>.mw-parser-output .hatnote{font-style:italic}.mw-parser-output div.hatnote{padding-left:1.6em;margin-bottom:0.5em}.mw-parser-output .hatnote i{font-style:normal}.mw-parser-output .hatnote+.mw-empty-elt+.hatnote{margin-top:-0.5em}@media print{body.ns-0 .mw-parser-output .hatnote{display:none!important}}</style></span><div role="note" class="hatnote navigation-not-searchable" about="#mwt2" id="mwBA">This article is about the novel. For the film adaptation, see <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Nickel_Boys" title="Nickel Boys">Nickel Boys</a>.</div>
<p class="mw-empty-elt" id="mwBQ"><span typeof="mw:Nowiki mw:Transclusion" about="#mwt4" id="mwBg" data-mw='{"parts":[{"template":{"target":{"wt":"Use mdy dates","href":"./Template:Use_mdy_dates"},"params":{"date":{"wt":"December 2024"}},"i":0}}]}'></span><link rel="mw:PageProp/Category" href="./Category:Use_mdy_dates_from_December_2024" about="#mwt4" id="mwBw"/></p>
<span class="mw-empty-elt" about="#mwt5" typeof="mw:Transclusion" id="mwCA" data-mw='{"parts":[{"template":{"target":{"wt":"Infobox book\n","href":"./Template:Infobox_book"},"params":{"name":{"wt":"The Nickel Boys"},"image":{"wt":"The Nickel Boys (Colson Whitehead).png"},"border":{"wt":"yes"},"alt":{"wt":""},"caption":{"wt":"First edition cover"},"author":{"wt":"[[Colson Whitehead]]"},"audio_read_by":{"wt":"JD Jackson&lt;ref>{{Cite web |url=https://www.penguinrandomhouseaudio.com/book/223161/the-nickel-boys/ |title=The Nickel Boys by Colson Whitehead |website=[[Penguin Random House Audio]]}}&lt;/ref>&lt;br />Colson Whitehead"},"cover_artist":{"wt":"Neil Libbert (photograph)&lt;ref>{{Cite web |url=https://www.bookish.com/articles/judging-books-covers-july-2019/ |title=Brilliant Book Covers: The Best Covers of July 2019 |website=[[Bookish]]|date=April 24, 2015 }}&lt;/ref>&lt;br />Oliver Munday (design)"},"publication_place":{"wt":"United States"},"language":{"wt":"English"},"genre":{"wt":""},"set_in":{"wt":"[[Florida]] and [[New York City]]&lt;ref>{{Cite web |url=https://www.ft.com/content/575810b0-aa13-11e9-90e9-fc4b9d9528b4 |title=The Nickel Boys by Colson Whitehead — racism in America |last=Wagner |first=Erica |author-link=Erica Wagner |date=July 26, 2019 |website=[[Financial Times]] |access-date=September 25, 2019 |url-access=subscription}}&lt;/ref>"},"publisher":{"wt":"[[Doubleday (publisher)|Doubleday]]"},"publication_date":{"wt":"July 16, 2019"},"media_type":{"wt":"Print ([[Hardcover]])"},"pages":{"wt":"224"},"awards":{"wt":"[[Pulitzer Prize for Fiction]]&lt;br />[[Kirkus Prize|Kirkus Prize for Fiction]]&lt;br />[[Orwell Prize|Orwell Prize for Political Fiction]]"},"isbn":{"wt":"978-0-385-53707-0"},"dewey":{"wt":"813.54"},"congress":{"wt":"PS3573.H4768 N53 2019"}},"i":0}}]}'><style data-mw-deduplicate="TemplateStyles:r1358620234" typeof="mw:Extension/templatestyles" about="#mwt6" data-mw='{"name":"templatestyles","attrs":{"src":"Module:Infobox/styles.css"},"body":{"extsrc":""}}'>@media(min-width:640px){.mw-parser-output .infobox{margin-left:1em;float:right;clear:right;width:22em}}.mw-parser-output .infobox-subbox{padding:0;border:none;margin:-3px;width:auto;min-width:100%;font-size:100%;clear:none;float:none;background-color:transparent;color:inherit}.mw-parser-output .infobox-3cols-child{margin:-3px}.mw-parser-output .infobox .navbar{font-size:100%}.mw-parser-output .infobox-hiddenrow,body.skin--responsive.skin--responsive .mw-parser-output .infobox .infobox-hiddenrow{display:none}@media screen{html.skin-theme-clientpref-night .mw-parser-output .infobox-full-data:not(.notheme)>div:not(.notheme)[style]{background:#1f1f23!important;color:#f8f9fa}}@media screen and (prefers-color-scheme:dark){html.skin-theme-clientpref-os .mw-parser-output .infobox-full-data:not(.notheme)>div:not(.notheme)[style]{background:#1f1f23!important;color:#f8f9fa}}@media(min-width:640px){body.skin--responsive .mw-parser-output .infobox-table{display:table!important}body.skin--responsive .mw-parser-output .infobox-table>caption{display:table-caption!important}body.skin--responsive .mw-parser-output .infobox-table>tbody{display:table-row-group}body.skin--responsive .mw-parser-output .infobox-table th,body.skin--responsive .mw-parser-output .infobox-table td{padding-left:inherit;padding-right:inherit}}</style><style data-mw-deduplicate="TemplateStyles:r1287740527" typeof="mw:Extension/templatestyles" about="#mwt7" data-mw='{"name":"templatestyles","attrs":{"src":"Infobox book/styles.css"},"body":{"extsrc":""}}'>.mw-parser-output .ib-book .infobox-title{font-style:italic;padding-bottom:0.2em}.mw-parser-output .ib-book .Z3988{display:none}.mw-parser-output .ib-book .infobox-below{border-top:#aaa 1px solid}</style></span><table class="infobox ib-book vcard" about="#mwt5" id="mwCQ"><caption class="infobox-title">The Nickel Boys <span class="Z3988" title="ctx_ver=Z39.88-2004&amp;rft_val_fmt=info%3Aofi%2Ffmt%3Akev%3Amtx%3Abook&amp;rft.genre=book&amp;rft.bti